# Pinned upstream inputs. Change deliberately and re-test on the iPad.
QEMU_WASM_REPO=https://github.com/ktock/qemu-wasm
# Previously inspected upstream commit (from the project handoff). The uploaded qemu-wasm-master.zip carried no git metadata,
# so its equality with this commit could NOT be verified; fetch-upstream.sh always builds from a fresh checkout of this exact commit.
QEMU_WASM_COMMIT=0ef7b4e2814b231705d8371dd7997f5b72e70baf
# From the upstream Dockerfile / README at that revision:
EMSDK_VERSION=3.1.50
XTERM_VERSION=5.3.0
XTERM_PTY_VERSION=0.10.1
BUILDER_IMAGE=browserdroid-qemu-wasm-builder
BUILDER_CONTAINER=browserdroid-build-qemu-wasm
